    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@agentos/shared": "^0.1.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
