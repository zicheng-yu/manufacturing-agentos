# 复制为 .env 后按需修改：cp -n .env.example .env（-n：已有 .env 时不覆盖）
# 后端端口（前端开发服务器固定 5173，并把 /api 代理到这里）
API_PORT=8787

# 演示账号统一密码（账号：chairman / production / supply / quality / logistics / ehs / hr）
DEMO_PASSWORD=agentos-demo

# 事件桥与演示回放共用的令牌
BRIDGE_TOKEN=dev-bridge-token

# 数据集：默认赛道官方素材包；demo 为自带的虚构演示数据
# DATASET=demo

# 模型：任意 OpenAI 兼容接口。LLM_API_KEY 留空时以离线规则模式运行
# MiniMax：LLM_BASE_URL=https://api.minimaxi.com/v1  LLM_MODEL=MiniMax-M3.1-Flash（M3 推理过长，演示不用）
# 通义千问：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_API_KEY=
LLM_MODEL=MiniMax-M3.1-Flash
# 推理型模型的推理强度（low 可把响应压到数秒）；不支持该参数的模型留空
LLM_REASONING_EFFORT=low
